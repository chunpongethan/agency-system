# Copy to deploy/.env and fill in. Never commit the real .env.
#
#   cp deploy/.env.example deploy/.env && edit deploy/.env

# ---- Domains (DNS A records must point to this VM's public IP) ----
WEB_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
# Contact email for Let's Encrypt cert notifications.
ACME_EMAIL=you@yourdomain.com

# ---- Secrets — CHANGE THESE ----
# Generate SECRET_KEY with:  openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string
POSTGRES_PASSWORD=replace-with-a-strong-db-password

# ---- First admin (created on first boot; NO demo data is loaded) ----
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Administrator
ADMIN_CODE=A000

# ---- Second company (CPM) admin — OPTIONAL ----
# Fill these to create the CPM company's admin on next boot. Leave blank to skip.
# The code MUST start with "cpm" — that prefix assigns the account to CPM.
# Log in with CPM_ADMIN_CODE (cpm000) or CPM_ADMIN_EMAIL + the password below.
# Idempotent: an existing cpm000/email is left untouched (password NOT reset).
CPM_ADMIN_EMAIL=
CPM_ADMIN_PASSWORD=
CPM_ADMIN_NAME=CPM Administrator
CPM_ADMIN_CODE=cpm000

# ---- Email (password resets) ----
# If SMTP_HOST is blank, reset links are logged to the API console instead of
# emailed. Set these to actually deliver password-reset mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com
SMTP_TLS=true

# ---- WeChat messaging (企業微信 / WeCom「客戶聯繫」) — OPTIONAL ----
# Lets an admin push a message to an agent's PERSONAL WeChat. Personal WeChat has
# no official API; this uses WeCom's external-contact bridge, which requires:
#   * a VERIFIED (認證) 企業微信 org with 客戶聯繫 enabled;
#   * a sender member (WECOM_SENDER_USERID) with 客戶聯繫 permission;
#   * each target agent has ADDED that member as an external contact on WeChat.
# Note: WeChat caps enterprise group-sends at ~1 per customer per day, and some
# org configs require the sender member to tap 發送 in their WeCom app.
# Leave blank to disable WeChat messaging (the admin action returns "not configured").
WECOM_CORP_ID=
WECOM_CONTACT_SECRET=
WECOM_SENDER_USERID=

# ---- AI Knowledge Base (Anthropic Claude) — OPTIONAL ----
# Set ANTHROPIC_API_KEY to enable the AI assistant on the Knowledge Base page.
# Leave blank to ship the knowledge base with keyword search only (no AI chat).
# Get a key at https://console.anthropic.com/ . Never commit the real key.
ANTHROPIC_API_KEY=
# Model id (default claude-sonnet-5). Use a Haiku model for lower cost, or an
# Opus model for maximum quality.
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Optional overrides (sane defaults) ----
POSTGRES_USER=agency
POSTGRES_DB=agency
ACCESS_TOKEN_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=30

# ---- Prebuilt-image variant only (docker-compose.prod.images.yml) ----
# Where the CI-built images live, e.g. ghcr.io/<owner>/<repo>
IMAGE_PREFIX=ghcr.io/chunpongethan/agency-system
IMAGE_TAG=latest
